# BotFather token and my.telegram.org API credentials are private secrets.
BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
# Usually leave unset; aiogram derives the local file endpoint.
TELEGRAM_LOCAL_FILE_URL=
# Comma-separated Telegram numeric user IDs; empty means nobody is authorized.
ADMIN_IDS=
DRIVE_MOUNT_POINT=/content/drive
DRIVE_ROOT=/content/drive/MyDrive
# Optional comma-separated additional mounted directories.
DRIVE_SHARED_DRIVE_ROOTS=
INDEX_FILENAME=_drive_telegram_index.csv
TEMP_DIR=/content/dtm-tmp
MAX_CONCURRENT_JOBS=2
MAX_FILES_PER_BATCH=20
TRANSFER_CHUNK_SIZE_MB=512
PROGRESS_UPDATE_INTERVAL=5
RETRY_ATTEMPTS=3
MAX_OPERATION_GB=100
LOG_LEVEL=INFO
